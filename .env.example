# Detection-test environment variables
# Copy this file to .env.local for local development.

# Optional application URL for callbacks and generated links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Profesional autenticado
#
# Mientras el login no verifique credenciales, la sesion se resuelve en el
# servidor desde estas variables (ver lib/auth/session.ts). Ningun componente
# de la plataforma conoce un nombre, un rol o una institucion que no venga de
# aqui: si no se definen, la interfaz muestra un profesional generico en lugar
# de inventar datos.
# ---------------------------------------------------------------------------
DETECTION_TEST_USER_ID="profesional-local"
DETECTION_TEST_USER_NAME=""
DETECTION_TEST_USER_EMAIL=""
# SUPER_ADMIN | ADMIN_INSTITUCION | PSICOPEDAGOGO | DECE | DOCENTE_APOYO | DOCENTE | CONSULTA
DETECTION_TEST_USER_ROLE="PSICOPEDAGOGO"
DETECTION_TEST_USER_TITLE="Psicopedagogia"

DETECTION_TEST_INSTITUTION_ID="institucion-local"
DETECTION_TEST_INSTITUTION_NAME=""
DETECTION_TEST_INSTITUTION_DISTRICT=""

# ---------------------------------------------------------------------------
# Base de datos
#
# prisma/schema.prisma es un contrato de datos preparado para el dia que exista
# backend, pero HOY NO SE USA: no hay cliente de Prisma instalado ni rutas de
# API. La persistencia de las evaluaciones vive en el navegador, detras de
# lib/evaluations/store.ts, que es el unico punto que habria que reescribir.
# ---------------------------------------------------------------------------
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/detection_test?schema=public"
